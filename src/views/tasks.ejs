<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Tasks - Task Manager</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/app.js"></script>
</head>
<body>
    <div class="container">
        <!-- DOM-based XSS target divs -->
        <div id="notification-message" style="display:none; background-color: #d4edda; padding: 10px; margin-bottom: 15px; border-radius: 4px;"></div>
        <div id="welcome-message"></div>

        <h1>My Tasks</h1>
        <p>Welcome, <%= user.username %>! <a href="/auth/logout">Logout</a></p>

        <div class="search-box">
            <form action="/tasks/search" method="GET">
                <input type="text" name="q" placeholder="Search tasks...">
                <button type="submit">Search</button>
            </form>
        </div>

        <a href="/tasks/new" class="btn">Create New Task</a>

        <div class="tasks-list">
            <% if (tasks.length === 0) { %>
                <p>No tasks yet. Create your first task!</p>
            <% } else { %>
                <% tasks.forEach(task => { %>
                    <div class="task-item">
                        <!-- VULNERABILITY: Stored XSS - using <%- %> which doesn't escape HTML -->
                        <h3><%- task.title %></h3>
                        <p><%- task.description %></p>
                        <a href="/tasks/<%= task.id %>/edit">Edit</a>
                        <form action="/tasks/<%= task.id %>/delete" method="POST" style="display:inline;">
                            <button type="submit">Delete</button>
                        </form>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </div>
</body>
</html>
